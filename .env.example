# Public site URL (production)
NEXT_PUBLIC_APP_URL=https://www.hyperioninvoices.com.au

# Persistent accounts — Neon / Postgres. Do not commit real secrets.
# Attach Neon in the Vercel project Storage tab (sets DATABASE_URL).
DATABASE_URL=
SESSION_SECRET=
# Optional alias — the app also accepts this name for the same cookie signing secret.
NEXTAUTH_SECRET=

# Stripe Checkout — test mode. Do not commit real secrets.
# Create a $69 AUD / month recurring Price in Stripe test mode.
# Checkout uses payment_method_types=card (debit, credit, Apple Pay, Google Pay).
# Register Apple Pay domains in Stripe Dashboard — see docs/STRIPE_APPLE_PAY.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Quote email — optional. Leave empty to keep Send quote UI with a clear fallback.
# Gmail app password (smtp.gmail.com) or generic SMTP / Resend.
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_API_KEY=

# Australian Business Register (optional). GUID from ABR web services — never commit a real value.
# Without this, /api/abr/search uses HyperionInvoices' demo register so name typeahead still works.
# https://abr.business.gov.au/Tools/WebServices
ABR_GUID=
