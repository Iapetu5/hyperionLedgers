# Public site URL (production)
NEXT_PUBLIC_APP_URL=https://www.hyperioninvoices.com.au

# Persistent accounts — Neon / Postgres. Do not commit real secrets.
# Attach Neon in the Vercel project Storage tab (sets DATABASE_URL).
DATABASE_URL=
SESSION_SECRET=
# Optional alias — the app also accepts this name for the same cookie signing secret.
NEXTAUTH_SECRET=

# Stripe Checkout — test mode. Do not commit real secrets.
# Create a $69 AUD / month recurring Price in Stripe test mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
